<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Chrome Suite" parallel="tests" thread-count="2">
    <test name="Chrome Browser Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.ButtonsTest"/>
            <class name="tests.TextBoxTest"/>
            <class name="tests.CheckBoxTest"/>
            <class name="tests.RadioButtonTest"/>
            <class name="tests.AlertsTest"/>
            <class name="tests.DynamicPropertiesTest"/>
            <class name="tests.ModalDialogsTest"/>
            <class name="tests.ToolTipsTest"/>
            <class name="tests.UploadDownloadTest"/>
            <class name="tests.WebTablesTest"/>
        </classes>
    </test>
    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="tests.ButtonsTest"/>
            <class name="tests.TextBoxTest"/>
            <class name="tests.CheckBoxTest"/>
            <class name="tests.RadioButtonTest"/>
            <class name="tests.AlertsTest"/>
            <class name="tests.DynamicPropertiesTest"/>
            <class name="tests.ModalDialogsTest"/>
            <class name="tests.ToolTipsTest"/>
            <class name="tests.UploadDownloadTest"/>
            <class name="tests.WebTablesTest"/>
        </classes>
    </test>
</suite>

